# Telegram Bot để nhận lead từ form liên hệ
# Tạo bot tại https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat ID nhận tin nhắn (của bạn hoặc group)
# Lấy bằng cách: nhắn cho bot → truy cập https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# Domain production (dùng cho canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://ngoandang.vn

# ===== TRANG ADMIN (/admin) =====
# Mật khẩu đăng nhập trang quản trị (đặt chuỗi dài, khó đoán)
ADMIN_PASSWORD=doi-mat-khau-nay-di

# Repo GitHub chứa nội dung (admin lưu bài bằng cách commit lên đây)
GITHUB_OWNER=dungvt1234
GITHUB_REPO=ngoan-dang-bds
# Token GitHub: github.com → Settings → Developer settings → Personal access
# tokens (classic) → New token → chỉ tick quyền "repo" → copy dán vào đây.
# KHÔNG commit file .env.local chứa token này lên Git.
GITHUB_TOKEN=your_github_token_here

# Vercel Deploy Hook để nút "Đăng lên web" build lại site:
# Vercel Dashboard → Project cinematic-estate → Settings → Git →
# Deploy Hooks → Create Hook (branch master) → copy URL dán vào đây.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
